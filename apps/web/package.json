{
  "name": "@lazydata/steward",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @lazydata/validator build && vite dev",
    "build": "pnpm --filter @lazydata/validator build && vite build",
    "start": "node scripts/start.ts",
    "lint": "eslint . --max-warnings=0",
    "check": "pnpm --filter @lazydata/validator build && svelte-kit sync && svelte-check --fail-on-warnings && tsc -p tsconfig.test.json",
    "test": "pnpm build && node --test --test-timeout=60000 test/*.test.ts"
  },
  "dependencies": {
    "@lazydata/validator": "workspace:*",
    "jsonc-parser": "3.3.1",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.70.0",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.0",
    "bits-ui": "^2.20.0",
    "cn": "^0.5.2",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "shadcn-svelte": "^1.8.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.6"
  }
}
