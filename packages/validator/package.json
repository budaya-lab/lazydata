{
  "name": "@lazydata/validator",
  "version": "0.0.0",
  "description": "Read-only dataset metadata and repository validation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "default": "./dist/repository.js"
    },
    "./policy": "./dataset.config.json"
  },
  "bin": {
    "lazydata-validate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "dataset.config.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  }
}
