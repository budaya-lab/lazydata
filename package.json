{
  "name": "lazydata",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "pnpm --filter @penjaga/validator build",
    "lint": "pnpm --filter @penjaga/steward lint",
    "typecheck": "pnpm --filter @penjaga/validator typecheck",
    "test": "node --test scripts/*.test.ts && pnpm --filter @penjaga/validator test",
    "pack:validator": "pnpm build && pnpm --filter @penjaga/validator pack"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
